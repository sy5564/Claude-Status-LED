{
  "description": "Sends every Claude Code event to the status LED with curl (POST /hook). The LED evaluates it itself.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl.exe",
            "args": [
              "-s",
              "-m",
              "3",
              "-F",
              "hook=@-;filename=hook.json;type=application/json",
              "${user_config.led_url}/hook"
            ],
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl.exe",
            "args": [
              "-s",
              "-m",
              "3",
              "-F",
              "hook=@-;filename=hook.json;type=application/json",
              "${user_config.led_url}/hook"
            ],
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
